    nNumberOfSlots : INT := 14;
END_VAR
VAR
    stFilter : ARRAY [1..nNumberOfSlots] OF ST_Filter;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="GetConfiguration" Id="{c9eefbaf-dcdf-44b0-8e9c-966cbc404b6a}">
      <Declaration><![CDATA[
METHOD GetConfiguration
VAR_OUTPUT
    stFilter : ARRAY [1..14] OF ST_Filter;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[stFilter := THIS^.stFilter;]]></ST>
      </Implementation>
    </Method>
    <Method Name="GetFilter" Id="{f3113dd3-83dc-41e8-8f98-24b65c8cff42}">
      <Declaration><![CDATA[
METHOD GetFilter : ST_Filter
VAR_INPUT
